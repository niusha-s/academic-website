---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Contact | Robotics Researcher";
const pageDescription = "Get in touch for collaborations or academic inquiries.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-xl space-y-10 py-8 px-4">
    <header class="space-y-3">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">Contact</h1>
      <p class="text-lg text-slate-600 leading-relaxed">
        Feel free to reach out for research collaborations, discussions on robotics, or just to connect.
      </p>
    </header>
    
    <div class="space-y-4">
      
      <!-- Academic Email -->
      <a href="mailto:niushasegh@aut.ac.ir" class="group p-4 bg-slate-50 border border-slate-100 rounded-xl flex items-center gap-4 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all">
        <span class="w-6 h-6 text-slate-500 group-hover:text-indigo-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9.5C2 7 4 5 6.5 5H17.5C20 5 22 7 22 9.5V17Z"/><polyline points="15 9 18.5 12 22 9"/><path d="M12 12V19"/><path d="M12 12L9 15"/><path d="M12 12L15 15"/></svg>
        </span>
        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Academic Email</span>
          <span class="text-slate-900 font-medium">niushasegh@aut.ac.ir</span>
        </div>
      </a>

      <!-- Personal Email -->
      <a href="mailto:niushasedgh@gmail.com" class="group p-4 bg-slate-50 border border-slate-100 rounded-xl flex items-center gap-4 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all">
        <span class="w-6 h-6 text-slate-500 group-hover:text-indigo-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </span>
        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Gmail</span>
          <span class="text-slate-900 font-medium">niushasedgh@gmail.com</span>
        </div>
      </a>

      <!-- LinkedIn -->
      <a href="https://www.linkedin.com/in/niusha-sedgh/" target="_blank" class="group p-4 bg-slate-50 border border-slate-100 rounded-xl flex items-center gap-4 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all">
        <span class="w-6 h-6 text-slate-500 group-hover:text-indigo-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </span>
        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">LinkedIn</span>
          <span class="text-slate-900 font-medium">linkedin.com/in/niusha-sedgh/</span>
        </div>
      </a>
      <!-- ORCID -->
      <a
        href="https://orcid.org/0009-0009-6035-981X"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 bg-slate-50 border border-slate-100 rounded-xl flex items-center gap-4 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all"
      >
        <span class="w-6 h-6 text-slate-500 group-hover:text-indigo-600 transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.3 5.2h2.8c2.4 0 3.9 1.3 3.9 3.3 0 1.5-.8 2.6-2.1 3.1l2.5 3.2h-2.1l-2.2-2.9h-1.1v2.9h-1.7V7.2Zm1.7 1.5v3.7h1c1.6 0 2.3-.6 2.3-1.9 0-1.2-.7-1.8-2.3-1.8h-1Z"/>
          </svg>
        </span>

        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">
            ORCID
          </span>
          <span class="text-slate-900 font-medium">
            0009-0009-6035-981X
          </span>
        </div>
      </a>

      <!-- GitHub -->
      <a href="https://github.com/username" target="_blank" class="group p-4 bg-slate-50 border border-slate-100 rounded-xl flex items-center gap-4 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all">
        <span class="w-6 h-6 text-slate-500 group-hover:text-indigo-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </span>
        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">GitHub</span>
          <span class="text-slate-900 font-medium">github.com/niusha_s</span>
        </div>
      </a>

      <!-- Instagram -->
      <a href="https://www.instagram.com/niusha_sedgh/?hl=en" target="_blank" class="group p-4 bg-slate-50 border border-slate-100 rounded-xl flex items-center gap-4 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all">
        <span class="w-6 h-6 text-slate-500 group-hover:text-indigo-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        </span>
        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Instagram</span>
          <span class="text-slate-900 font-medium">@niusha_sedgh</span>
        </div>
      </a>

    </div>
  </div>
</BaseLayout>
