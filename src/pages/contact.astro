---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Robotics Researcher" description="Get in touch.">
  <div class="max-w-xl space-y-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Contact</h1>
    <p class="text-slate-600">
      Feel free to reach out for collaborations, discussions on state estimation, or robotics projects.
    </p>
    
    <div class="space-y-4">
      <div>
        <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Email</span>
        <a href="mailto:your.email@example.com" class="text-blue-600 hover:underline">your.email@example.com</a>
      </div>
      <div>
        <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">GitHub</span>
        <a href="https://github.com" target="_blank" class="text-blue-600 hover:underline">github.com/username</a>
      </div>
    </div>
  </div>
</BaseLayout>
