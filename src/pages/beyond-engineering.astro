---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Beyond Engineering";
const pageDescription = "Exploring the intersection of control systems, fine arts, and visual expression.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-3xl space-y-12 py-8 px-4">
    
    <!-- Header Section -->
    <header class="border-b border-slate-100 pb-8">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-3">{pageTitle}</h1>
      <p class="text-lg text-slate-600 leading-relaxed">
        While engineering structures the physical and digital world, art provides the language to explore what lies beyond mathematical formulations. This space is dedicated to my journey in visual arts, professional painting, and the creative philosophy that bridges these two domains.
      </p>
    </header>

    <!-- Instagram Callout Card -->
    <section class="p-6 bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 border border-indigo-100/50 rounded-2xl shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <h2 class="text-xl font-bold text-slate-900">Explore My Art Gallery</h2>
        <p class="text-sm text-slate-600">
          I share my latest paintings, sketches, and ongoing visual explorations on Instagram. Follow my artistic timeline there.
        </p>
      </div>
      <a 
        href="https://www.instagram.com/niusha_sedgh/?hl=en" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-medium rounded-xl transition-all duration-300 shadow-sm hover:shadow-md shrink-0"
      >
        Visit Instagram Profile
      </a>
    </section>

    <!-- Featured Artworks Section -->
    <section class="space-y-8">
      <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Traditional Portfolio</h2>
      
      <div class="space-y-6" id="artworks-container">
        <!-- Artwork Card 1 (Always Visible) -->
        <div class="group bg-slate-50 border border-slate-100/80 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col md:flex-row">
          <!-- Left Content Area -->
          <div class="p-6 flex-1 flex flex-col justify-between order-2 md:order-1">
            <div>
              <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
                <span>Medium: Oil on Canvas</span>
                <span>•</span>
                <span>2020</span>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Emerald Gaze</h3>
              <p class="text-slate-600 leading-relaxed">
               A study of light, texture, and the intricate details of the human eye, exploring how a single glance can convey depth and emotion.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/50 flex gap-2">
              <span class="bg-purple-100/70 text-purple-700 px-3 py-1 rounded-full text-xs font-semibold">Hyper realism</span>
              <span class="bg-slate-200/60 text-slate-700 px-3 py-1 rounded-full text-xs font-semibold">20x30 cm</span>
            </div>
          </div>
          <!-- Right Image Area -->
          <div class="h-64 md:h-auto md:w-72 shrink-0 order-1 md:order-2 bg-slate-200 overflow-hidden">
            <img 
              src="/images/art/artwork1.jpg" 
              alt="Silent Resonance Painting" 
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-170"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Artwork Card 2 (Always Visible) -->
        <div class="group bg-slate-50 border border-slate-100/80 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col md:flex-row">
          <!-- Left Content Area -->
          <div class="p-6 flex-1 flex flex-col justify-between order-2 md:order-1">
            <div>
              <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
                <span>Medium: Charcoal & Graphite on Paper</span>
                <span>•</span>
                <span>2022</span>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Monochrome Portrait Study</h3>
              <p class="text-slate-600 leading-relaxed">
                 monochromatic portrait focusing on high-contrast lighting, continuous tonal gradients, and fine organic textures. By layering charcoal and graphite, the composition captures complex subsurface skin details and hair volume through controlled value transitions.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/50 flex gap-2">
              <span class="bg-purple-100/70 text-purple-700 px-3 py-1 rounded-full text-xs font-semibold">Realism</span>
              <span class="bg-slate-200/60 text-slate-700 px-3 py-1 rounded-full text-xs font-semibold">60x80 cm</span>
            </div>
          </div>
          <!-- Right Image Area -->
          <div class="h-64 md:h-auto md:w-72 shrink-0 order-1 md:order-2 bg-slate-200 overflow-hidden">
            <img 
              src="/images/art/artwork2.jpg" 
              alt="Chiaroscuro Dynamics Sketch" 
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-150"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Artwork Card 3 (Initially Hidden) -->
        <div class="extra-card hidden group bg-slate-50 border border-slate-100/80 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col md:flex-row opacity-0 transition-opacity duration-500">
          <!-- Left Content Area -->
          <div class="p-6 flex-1 flex flex-col justify-between order-2 md:order-1">
            <div>
              <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
                <span>Medium: Acrylic on Wood Panel</span>
                <span>•</span>
                <span>2025</span>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Convergence</h3>
              <p class="text-slate-600 leading-relaxed">
                An exploration of geometric patterns intersecting with organic fluid shapes, highlighting the harmony between structure and chaos.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/50 flex gap-2">
              <span class="bg-purple-100/70 text-purple-700 px-3 py-1 rounded-full text-xs font-semibold">Abstract</span>
              <span class="bg-slate-200/60 text-slate-700 px-3 py-1 rounded-full text-xs font-semibold">50x50 cm</span>
            </div>
          </div>
          <!-- Right Image Area -->
          <div class="h-64 md:h-auto md:w-72 shrink-0 order-1 md:order-2 bg-slate-200 overflow-hidden">
            <img 
              src="/images/art/artwork3.jpg" 
              alt="Convergence Painting" 
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-150"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Artwork Card 4 (Initially Hidden) -->
        <div class="extra-card hidden group bg-slate-50 border border-slate-100/80 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col md:flex-row opacity-0 transition-opacity duration-500">
          <!-- Left Content Area -->
          <div class="p-6 flex-1 flex flex-col justify-between order-2 md:order-1">
            <div>
              <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
                <span>Medium: Ink & Watercolor on Paper</span>
                <span>•</span>
                <span>2024</span>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Fluidity of Logic</h3>
              <p class="text-slate-600 leading-relaxed">
                Detailed linework layered over watercolor gradients, visualizing the transition of digital constraints into visual forms.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/50 flex gap-2">
              <span class="bg-purple-100/70 text-purple-700 px-3 py-1 rounded-full text-xs font-semibold">Minimalism</span>
              <span class="bg-slate-200/60 text-slate-700 px-3 py-1 rounded-full text-xs font-semibold">30x30 cm</span>
            </div>
          </div>
          <!-- Right Image Area -->
          <div class="h-64 md:h-auto md:w-72 shrink-0 order-1 md:order-2 bg-slate-200 overflow-hidden">
            <img 
              src="/images/art/artwork4.jpg" 
              alt="Fluidity of Logic Sketch" 
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-150"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Show More / Show Less Button -->
      <div class="flex justify-center mt-8">
        <button 
          id="show-more-btn" 
          class="px-6 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 rounded-full shadow-sm transition-all duration-200 flex items-center gap-2"
        >
          <span>Show More</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200" id="btn-arrow">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const showMoreBtn = document.getElementById('show-more-btn');
    const extraCards = document.querySelectorAll('.extra-card');
    const btnArrow = document.getElementById('btn-arrow');
    let isExpanded = false;

    if (showMoreBtn && extraCards.length > 0) {
      showMoreBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;

        if (isExpanded) {
          // Show extra cards
          extraCards.forEach((card) => {
            card.classList.remove('hidden');
            setTimeout(() => {
              card.classList.remove('opacity-0');
              card.classList.add('opacity-100');
            }, 10);
          });
          
          // Update button text and rotate arrow
          const btnText = showMoreBtn.querySelector('span');
          if (btnText) btnText.textContent = 'Show Less';
          if (btnArrow) btnArrow.style.transform = 'rotate(180deg)';

        } else {
          // Hide extra cards
          extraCards.forEach((card) => {
            card.classList.remove('opacity-100');
            card.classList.add('opacity-0');
            
            card.addEventListener('transitionend', function handler() {
              card.classList.add('hidden');
              card.removeEventListener('transitionend', handler);
            });
          });

          // Reset button text and rotate arrow back
          const btnText = showMoreBtn.querySelector('span');
          if (btnText) btnText.textContent = 'Show More';
          if (btnArrow) btnArrow.style.transform = 'rotate(0deg)';
          
          // Smooth scroll back to the artworks container
          const container = document.getElementById('artworks-container');
          if (container) {
            container.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    }
  });
</script>
