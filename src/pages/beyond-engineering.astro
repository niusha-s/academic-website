---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Beyond Engineering";
const pageDescription =
  "Exploring the intersection of control systems, fine arts, and visual expression.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-3xl space-y-12 py-8 px-4">

    <!-- Header Section -->
    <header class="border-b border-slate-100 pb-8">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-3">
        {pageTitle}
      </h1>

      <p class="text-lg text-slate-600 leading-relaxed">
        Engineering gives me a language for structure and precision, but I've
        always needed another outlet for the things that don't fit neatly into
        an equation. Painting and drawing have been part of my life for as long
        as robotics has, and this page is where I share that side of my work.
      </p>
    </header>


    <!-- Instagram Callout Card -->
    <section
      class="p-6 bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 border border-indigo-100/50 rounded-2xl shadow-sm flex flex-col md:flex-row items-center justify-between gap-6"
    >
      <div class="space-y-2 text-center md:text-left">
        <h2 class="text-xl font-bold text-slate-900">
          Explore My Art Gallery
        </h2>

        <p class="text-sm text-slate-600">
          I share my latest paintings, sketches, and ongoing visual
          explorations on Instagram. Follow my artistic timeline there.
        </p>
      </div>

      <a
        href="https://www.instagram.com/niusha_sedgh/?hl=en"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-medium rounded-xl transition-all duration-300 shadow-sm hover:shadow-md shrink-0"
      >
        Visit Instagram Profile
      </a>
    </section>


  <!-- Traditional Work -->
<section class="space-y-8 border border-slate-200 rounded-2xl p-5 md:p-5">

  <!-- Section Header -->
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-600 tracking-tight">
      Traditional Work
    </h2>

    <button
      id="traditional-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="traditional-work"
      class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
    >
      <span id="traditional-toggle-text">Show Work</span>

      <svg
        id="traditional-arrow"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-300"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </button>
  </div>


      <!-- Traditional Work Content -->
      <div id="traditional-work" class="hidden space-y-6">

        <!-- Artwork 1 -->
        <div
          class="group bg-slate-50 border border-slate-100/80 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col md:flex-row"
        >
          <div
            class="p-6 flex-1 flex flex-col justify-between order-2 md:order-1"
          >
            <div>
              <div
                class="flex items-center gap-3 text-sm text-slate-500 mb-3"
              >
                <span>Medium: Oil on Canvas</span>
                <span>•</span>
                <span>2020</span>
              </div>

              <h3 class="text-2xl font-bold text-slate-900 mb-3">
                Emerald Gaze
              </h3>

              <p class="text-slate-600 leading-relaxed">
               Technique: Hyper-realism<br />
                Medium: Oil on Canvas<br />
                Size: 20 × 30 cm
              </p>
            </div>

            <div
              class="mt-4 pt-4 border-t border-slate-200/50 flex gap-2"
            >
              <span
                class="bg-purple-100/70 text-purple-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                Hyper realism
              </span>

              <span
                class="bg-slate-200/60 text-slate-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                20×30 cm
              </span>
            </div>
          </div>

          <div
            class="h-64 md:h-auto md:w-72 shrink-0 order-1 md:order-2 bg-slate-200 overflow-hidden"
          >
            <img
              src="/images/art/artwork1.jpg"
              alt="Emerald Gaze painting"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
              loading="lazy"
            />
          </div>
        </div>


        <!-- Artwork 2 -->
        <div
          class="group bg-slate-50 border border-slate-100/80 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col md:flex-row"
        >
          <div
            class="p-6 flex-1 flex flex-col justify-between order-2 md:order-1"
          >
            <div>
              <div
                class="flex items-center gap-3 text-sm text-slate-500 mb-3"
              >
                <span>Medium: Charcoal & Graphite on Paper</span>
                <span>•</span>
                <span>2022</span>
              </div>

              <h3 class="text-2xl font-bold text-slate-900 mb-3">
                Monochrome Portrait Study
              </h3>

              <p class="text-slate-600 leading-relaxed">
                A close study in black and white — building up skin texture and
                hair through layers of charcoal and graphite, and letting
                strong, high-contrast lighting do most of the work.
              </p>
            </div>

            <div
              class="mt-4 pt-4 border-t border-slate-200/50 flex gap-2"
            >
              <span
                class="bg-purple-100/70 text-purple-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                Realism
              </span>

              <span
                class="bg-slate-200/60 text-slate-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                60×80 cm
              </span>
            </div>
          </div>

          <div
            class="h-64 md:h-auto md:w-72 shrink-0 order-1 md:order-2 bg-slate-200 overflow-hidden"
          >
            <img
              src="/images/art/artwork2.jpg"
              alt="Monochrome portrait study"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
              loading="lazy"
            />
          </div>
        </div>


        

      </div>
    </section>


   <!-- Digital Work -->
<section class="space-y-8 border border-slate-200 rounded-2xl p-5 md:p-5">

  <!-- Section Header -->
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-600 tracking-tight">
      Digital Work
    </h2>

    <button
      id="digital-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="digital-work"
      class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
    >
      <span id="digital-toggle-text">Show Work</span>

      <svg
        id="digital-arrow"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-300"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </button>
  </div>


      <!-- Digital Work Content -->
      <div id="digital-work" class="hidden space-y-6">

        <!-- Digital Work 1 -->
        <div
          class="group bg-slate-50 border border-slate-100/80 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col md:flex-row"
        >
          <div
            class="p-6 flex-1 flex flex-col justify-between order-2 md:order-1"
          >
            <div>
              <div
                class="flex items-center gap-3 text-sm text-slate-500 mb-3"
              >
                <span>Digital Art</span>
                <span>•</span>
                <span>2026</span>
              </div>

              <h3 class="text-2xl font-bold text-slate-900 mb-3">
                Digital Artwork
              </h3>

              <p class="text-slate-600 leading-relaxed">
                Digital illustration exploring composition, color, and visual
                storytelling.
              </p>
            </div>

            <div
              class="mt-4 pt-4 border-t border-slate-200/50 flex gap-2"
            >
              <span
                class="bg-indigo-100/70 text-indigo-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                Digital Art
              </span>
            </div>
          </div>

          <div
            class="h-64 md:h-auto md:w-72 shrink-0 order-1 md:order-2 bg-slate-200 overflow-hidden"
          >
            <img
              src="/images/art/digital1.jpg"
              alt="Digital artwork"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
              loading="lazy"
            />
          </div>
        </div>


        <!-- Digital Work 2 -->
        <div
          class="group bg-slate-50 border border-slate-100/80 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col md:flex-row"
        >
          <div
            class="p-6 flex-1 flex flex-col justify-between order-2 md:order-1"
          >
            <div>
              <div
                class="flex items-center gap-3 text-sm text-slate-500 mb-3"
              >
                <span>Digital Illustration</span>
                <span>•</span>
                <span>2026</span>
              </div>

              <h3 class="text-2xl font-bold text-slate-900 mb-3">
                Digital Study
              </h3>

              <p class="text-slate-600 leading-relaxed">
                A digital study focused on form, lighting, and visual
                composition.
              </p>
            </div>

            <div
              class="mt-4 pt-4 border-t border-slate-200/50 flex gap-2"
            >
              <span
                class="bg-indigo-100/70 text-indigo-700 px-3 py-1 rounded-full text-xs font-semibold"
              >
                Illustration
              </span>
            </div>
          </div>

          <div
            class="h-64 md:h-auto md:w-72 shrink-0 order-1 md:order-2 bg-slate-200 overflow-hidden"
          >
            <img
              src="/images/art/digital2.jpg"
              alt="Digital illustration"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </section>

  </div>
</BaseLayout>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = [
      {
        button: 'traditional-toggle',
        container: 'traditional-work',
        text: 'traditional-toggle-text',
        arrow: 'traditional-arrow'
      },
      {
        button: 'digital-toggle',
        container: 'digital-work',
        text: 'digital-toggle-text',
        arrow: 'digital-arrow'
      }
    ];

    sections.forEach(({ button, container, text, arrow }) => {
      const toggleButton = document.getElementById(button);
      const content = document.getElementById(container);
      const buttonText = document.getElementById(text);
      const arrowIcon = document.getElementById(arrow);

      if (!toggleButton || !content) return;

      toggleButton.addEventListener('click', () => {
        const isExpanded =
          toggleButton.getAttribute('aria-expanded') === 'true';

        toggleButton.setAttribute(
          'aria-expanded',
          String(!isExpanded)
        );

        content.classList.toggle('hidden', isExpanded);

        if (buttonText) {
          buttonText.textContent = isExpanded
            ? 'Show Work'
            : 'Hide Work';
        }

        if (arrowIcon) {
          arrowIcon.style.transform = isExpanded
            ? 'rotate(0deg)'
            : 'rotate(180deg)';
        }
      });
    });
  });
</script>