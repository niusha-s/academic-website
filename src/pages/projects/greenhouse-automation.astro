---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectTitle = "Green House Automation System";
---

<BaseLayout title={projectTitle}>
  <article class="mx-auto max-w-4xl px-4 py-10">

    <!-- HEADER -->
    <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-700">
      <h1 class="mb-4 text-4xl font-extrabold text-slate-900 dark:text-slate-100">
        {projectTitle}
      </h1>

      <div class="flex gap-2">
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-sm font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
          Embedded Systems
        </span>

        <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          2025
        </span>
      </div>
    </header>

    <!-- PROJECT OVERVIEW -->
    <section class="mb-12">
      <div class="border-l-4 border-gray-300 py-1 pl-6 dark:border-slate-600">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Project Overview
        </h2>

        <div class="prose prose-slate max-w-none dark:prose-invert">
          <p>
            This project focuses on the design and implementation of an automated
            greenhouse system for monitoring and controlling environmental
            conditions. The system continuously measures parameters such as
            temperature, humidity, and soil moisture to maintain suitable growing
            conditions for plants.
          </p>

          <p>
            Based on the sensor measurements, the control system automatically
            operates the corresponding actuators to regulate the greenhouse
            environment. The project demonstrates the integration of sensors,
            embedded control, and actuators in an automated agricultural application.
          </p>
        </div>
      </div>

      <!-- DOCUMENTATION SHORTCUT -->
      <div class="mb-10 mt-8 flex justify-end">
        <a
          href="#documentation"
          class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        >
          View Project Reports →
        </a>
      </div>
    </section>

    <div class="prose prose-slate max-w-none dark:prose-invert">

      <!-- HARDWARE DEMONSTRATION VIDEO -->
      <section class="mb-10">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Hardware Demonstration
        </h2>

        <div class="aspect-video w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-950 shadow-md dark:border-slate-700">
          <video
            controls
            preload="metadata"
            class="h-full w-full object-cover"
          >
            <source src="/videos/greenhouse-demo.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      </section>

      <!-- SYSTEM ARCHITECTURE -->
      <section class="mb-10">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          System Architecture
        </h2>

        <div class="my-6 flex items-center justify-center rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900">
          <img
            src="/images/projects/greenhouse-architecture.jpg"
            alt="Greenhouse Automation System Architecture Diagram"
            class="h-auto w-full max-w-2xl rounded-lg object-contain shadow-sm"
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>

      <!-- PROJECT DOCUMENTATION -->
      <section
        id="documentation"
        class="mb-10 border-t border-slate-200 pt-8 dark:border-slate-700"
      >
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Project Documentation
        </h2>

        <div class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-900 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">
              Technical Report
            </h3>

            <p class="text-sm text-slate-500 dark:text-slate-400">
              Embedded firmware architecture and hardware schematics.
            </p>
          </div>

          <a
            href="/files/reports/greenhouse-report.pdf"
            download
            class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400"
          >
            Download PDF Report
          </a>
        </div>
      </section>

    </div>

    <!-- FOOTER -->
    <footer class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-700">
      <a
        href="/projects"
        class="flex items-center gap-2 font-medium text-indigo-600 transition-colors hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
      >
        ← Back to Projects
      </a>
    </footer>

  </article>
</BaseLayout>