---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectTitle =
  "LiDAR-Based Localization & Environment Recognition for an Autonomous Aerial Vehicle";

const technologies = [
  "Python",
  "LiDAR",
  "Open3D",
  "Visual Odometry",
  "ICP",
  "EKF",
  "Sensor Fusion",
  "YOLO-World",
  "3D Object Localization"
];
---

<BaseLayout
  title={projectTitle}
  description="Multi-sensor localization and environment recognition using LiDAR, camera, and IMU."
>
  <article class="max-w-5xl mx-auto py-10 px-4">

    <!-- ================= HEADER ================= -->

    <header class="mb-10 border-b border-slate-200 pb-8">

      <div class="flex flex-wrap gap-2 mb-5">

        <span class="bg-blue-50 text-blue-700 border border-blue-100 px-3 py-1 rounded-full text-sm font-medium">
          Autonomous Vehicles
        </span>

        <span class="bg-slate-50 text-slate-600 border border-slate-200 px-3 py-1 rounded-full text-sm font-medium">
          2026
        </span>

        <span class="bg-emerald-50 text-emerald-700 border border-emerald-100 px-3 py-1 rounded-full text-sm font-medium">
          Completed
        </span>

      </div>

      <h1
        class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight mb-5"
      >
        {projectTitle}
      </h1>

      <p class="text-lg text-slate-600 leading-relaxed max-w-3xl">
        A multi-sensor localization and environment recognition pipeline
        integrating LiDAR, camera, and IMU data for autonomous navigation
        and 3D scene understanding.
      </p>

    </header>


    <!-- ================= PROJECT OVERVIEW ================= -->

    <section class="mb-12">

      <div class="border-l-4 border-gray-300 pl-6 py-1">

        <h2 class="text-2xl font-bold text-slate-900 mb-4">
          Project Overview
        </h2>

        <div class="prose prose-slate max-w-none">

          <p>
            This project focuses on developing a multi-sensor localization and
            environment recognition pipeline for an autonomous aerial vehicle
            operating in a simulated environment. The system integrates LiDAR,
            camera, and IMU data to estimate the vehicle's motion, evaluate its
            trajectory, and recognize and localize objects in the surrounding
            environment.
          </p>

          <p>
            The project combines classical robotics and state-estimation
            methods with learning-based perception to provide an integrated
            framework for autonomous navigation and environmental understanding.
          </p>

        </div>

      </div>

    </section>


    <!-- ================= QUICK LINKS ================= -->

    <section class="mb-12">

      <div
        class="bg-gradient-to-r from-slate-50 to-blue-50/60 border border-slate-200 rounded-2xl p-5"
      >

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">

          <div>
            <p class="text-sm font-semibold text-slate-800">
              Project Resources
            </p>

            <p class="text-sm text-slate-500 mt-1">
              Source code and detailed project documentation.
            </p>
          </div>


          <div class="flex flex-wrap gap-3">

            <a
              href="https://github.com/niusha-s/lidar-visual-localization.git"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-lg transition-colors shadow-sm"
            >
              View Source Code
            </a>

            <a
              href="/files/reports/aav-report.pdf"
              target="_blank"
              class="inline-flex items-center justify-center px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-colors shadow-sm"
            >
              View Project Report
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= HERO IMAGE ================= -->

    <section class="mb-14">

     <div
        class="max-w-2xl mx-auto rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100"
      >
        <img
          src="/images/projects/aav-hero.png"
          alt="AAV localization and environment recognition project"
          class="w-full h-auto object-cover"
        />
      </div>

      <p class="text-xs text-slate-400 mt-3 text-center">
        Autonomous aerial vehicle localization and environment recognition pipeline
      </p>

    </section>


    <!-- ================= PROJECT SNAPSHOTS ================= -->

    <section class="mb-14">

      <div class="mb-6">

        <h2 class="text-2xl font-bold text-slate-900">
          Project Snapshots
        </h2>

        <p class="text-sm text-slate-500 mt-1">
          Selected visual results from the project.
        </p>

      </div>


      <div class="grid md:grid-cols-2 gap-6">


        <!-- LiDAR -->

<figure class="group">

  <div
    class="max-w-sm mx-auto rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-sm"
  >
    <img
      src="/images/projects/aav-lidar.png"
      alt="LiDAR point cloud and localization"
      class="w-full aspect-square object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      loading="lazy"
    />
  </div>

  <figcaption class="max-w-sm mx-auto mt-3 px-1">
    <h3 class="text-sm font-semibold text-slate-800">
      LiDAR-Based Localization
    </h3>

    <p class="text-sm text-slate-500 mt-1">
      LiDAR point cloud processing and motion estimation.
    </p>
  </figcaption>

</figure>


<!-- Trajectory -->

<figure class="group">

  <div
    class="max-w-sm mx-auto rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-sm"
  >
    <img
      src="/images/projects/aav-trajectory.png"
      alt="Estimated and ground truth trajectories"
      class="w-full aspect-square object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      loading="lazy"
    />
  </div>

  <figcaption class="max-w-sm mx-auto mt-3 px-1">
    <h3 class="text-sm font-semibold text-slate-800">
      Trajectory Evaluation
    </h3>

    <p class="text-sm text-slate-500 mt-1">
      Estimated vehicle trajectory and ground-truth comparison.
    </p>
  </figcaption>

</figure>


        <!-- Visual Odometry -->

        <figure class="group">

          <div
            class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-sm"
          >

            <img
              src="/images/projects/aav-environment2.jpg"
              alt="Visual odometry and camera-based motion estimation"
              class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
            />

          </div>

          <figcaption class="mt-3 px-1">

            <h3 class="text-sm font-semibold text-slate-800">
              Visual Odometry
            </h3>

            <p class="text-sm text-slate-500 mt-1">
              Camera-based motion estimation using visual features.
            </p>

          </figcaption>

        </figure>


        <!-- Environment Recognition -->

        <figure class="group">

          <div
            class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-sm"
          >

            <img
              src="/images/projects/aav-environment.jpg"
              alt="Environment recognition and 3D object localization"
              class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
            />

          </div>

          <figcaption class="mt-3 px-1">

            <h3 class="text-sm font-semibold text-slate-800">
              Environment Recognition
            </h3>

            <p class="text-sm text-slate-500 mt-1">
              Object detection and 3D localization within the environment.
            </p>

          </figcaption>

        </figure>

      </div>

    </section>


    <!-- ================= PROJECT DEMO ================= -->

    <section class="mb-14">

      <div class="mb-6">

        <h2 class="text-2xl font-bold text-slate-900">
          Project Demo
        </h2>

        <p class="text-sm text-slate-500 mt-1">
          A visual demonstration of the implemented system.
        </p>

      </div>


      <div
        class="aspect-video w-full rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-slate-950"
      >

        <video
          controls
          preload="metadata"
          class="w-full h-full object-cover"
        >

          <source
            src="/videos/aav-demo.mp4"
            type="video/mp4"
          />

          Your browser does not support the video tag.

        </video>

      </div>

    </section>


   

    <!-- TECHNOLOGIES & METHODS -->
<section class="mb-14">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-900">Technologies & Methods</h2>
    <p class="text-sm text-slate-500 mt-1">
      Sensors, algorithms, and tools used for localization, state estimation,
      and environment recognition.
    </p>
  </div>

  <div class="grid md:grid-cols-2 gap-4">

    <!-- Sensors & Perception -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <h3 class="text-sm font-semibold text-slate-800 mb-3">
        Sensors & Perception
      </h3>

      <div class="flex flex-wrap gap-2">
        <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-medium">
          LiDAR
        </span>
        <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-medium">
          Camera
        </span>
        <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-medium">
          IMU
        </span>
        <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-medium">
          Visual Odometry
        </span>
        <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-medium">
          YOLO-World
        </span>
      </div>
    </div>

    <!-- Localization & Estimation -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <h3 class="text-sm font-semibold text-slate-800 mb-3">
        Localization & State Estimation
      </h3>

      <div class="flex flex-wrap gap-2">
        <span class="px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium">
          ICP
        </span>
        <span class="px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium">
          Extended Kalman Filter
        </span>
        <span class="px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium">
          Sensor Fusion
        </span>
        <span class="px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium">
          6-DoF Pose Estimation
        </span>
        <span class="px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium">
          Trajectory Evaluation
        </span>
      </div>
    </div>

    <!-- 3D Environment Understanding -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <h3 class="text-sm font-semibold text-slate-800 mb-3">
        3D Environment Understanding
      </h3>

      <div class="flex flex-wrap gap-2">
        <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium">
          Point Cloud Processing
        </span>
        <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium">
          Open3D
        </span>
        <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium">
          3D Object Localization
        </span>
        <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium">
          Object Detection
        </span>
      </div>
    </div>

    <!-- Software -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <h3 class="text-sm font-semibold text-slate-800 mb-3">
        Software & Tools
      </h3>

      <div class="flex flex-wrap gap-2">
        <span class="px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-medium">
          Python
        </span>
        <span class="px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-medium">
          Open3D
        </span>
        <span class="px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-medium">
          NumPy
        </span>
        <span class="px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-medium">
          Matplotlib
        </span>
      </div>
    </div>

  </div>
</section>

    <!-- ================= DOCUMENTATION ================= -->

    <section class="mb-12">

      <div
        class="rounded-2xl border border-indigo-100 bg-indigo-50/40 p-6"
      >

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">

          <div>

            <p class="text-xs uppercase tracking-wider font-semibold text-indigo-600 mb-1">
              Documentation
            </p>

            <h2 class="text-lg font-semibold text-slate-900">
              Project Report
            </h2>

            <p class="text-sm text-slate-500 mt-1">
              Detailed methodology, implementation, experiments, and results.
            </p>

          </div>


          <a
            href="/files/reports/aav-report.pdf"
            target="_blank"
            class="inline-flex items-center justify-center px-5 py-2.5
                   bg-white border border-indigo-200
                   text-indigo-700 font-semibold rounded-lg
                   hover:bg-indigo-50 transition-colors
                   shadow-sm whitespace-nowrap"
          >
            View Report →
          </a>

        </div>

      </div>

    </section>


    <!-- ================= FOOTER ================= -->

    <footer class="mt-12 pt-6 border-t border-slate-200">

      <a
        href="/projects"
        class="text-indigo-600 hover:text-indigo-800 font-medium flex items-center gap-2"
      >
        ← Back to Projects
      </a>

    </footer>

  </article>
</BaseLayout>