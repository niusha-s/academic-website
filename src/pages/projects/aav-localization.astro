---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectTitle =
  "LiDAR-Based Localization & Environment Recognition for an Autonomous Aerial Vehicle";

const technologies = [
  "Python",
  "LiDAR",
  "Open3D",
  "Visual Odometry",
  "ICP",
  "EKF",
  "Sensor Fusion",
  "YOLO-World",
  "3D Object Localization"
];
---

<BaseLayout
  title={projectTitle}
  description="Multi-sensor localization and environment recognition using LiDAR, camera, and IMU."
>
  <article class="mx-auto max-w-5xl px-4 py-10">

    <!-- ================= HEADER ================= -->

    <header class="mb-10 border-b border-slate-200 pb-8 dark:border-slate-700">

      <div class="mb-5 flex flex-wrap gap-2">
        <span class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-300">
          Autonomous Vehicles
        </span>

        <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
          2026
        </span>

        <span class="rounded-full border border-emerald-100 bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-300">
          Completed
        </span>
      </div>

      <h1 class="mb-5 text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-slate-100 md:text-5xl">
        {projectTitle}
      </h1>

      <p class="max-w-3xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        A multi-sensor localization and environment recognition pipeline
        integrating LiDAR, camera, and IMU data for autonomous navigation
        and 3D scene understanding.
      </p>

    </header>

    <!-- ================= PROJECT OVERVIEW ================= -->

    <section class="mb-12">
      <div class="border-l-4 border-gray-300 py-1 pl-6 dark:border-slate-600">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Project Overview
        </h2>

        <div class="prose prose-slate max-w-none dark:prose-invert">
          <p>
            This project focuses on developing a multi-sensor localization and
            environment recognition pipeline for an autonomous aerial vehicle
            operating in a simulated environment. The system integrates LiDAR,
            camera, and IMU data to estimate the vehicle's motion, evaluate its
            trajectory, and recognize and localize objects in the surrounding
            environment.
          </p>

          <p>
            The project combines classical robotics and state-estimation
            methods with learning-based perception to provide an integrated
            framework for autonomous navigation and environmental understanding.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= QUICK LINKS ================= -->

    <section class="mb-12">
      <div class="rounded-2xl border border-slate-200 bg-gradient-to-r from-slate-50 to-blue-50/60 p-5 dark:border-slate-700 dark:from-slate-900 dark:to-slate-800">

        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">
              Project Resources
            </p>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Source code and detailed project documentation.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="https://github.com/niusha-s/lidar-visual-localization.git"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-5 py-2.5 font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 dark:bg-indigo-600 dark:hover:bg-indigo-500"
            >
              View Source Code
            </a>

            <a
              href="/files/reports/aav-report.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-2.5 font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400"
            >
              View Project Report
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- ================= HERO IMAGE ================= -->

    <section class="mb-14">
      <div class="mx-auto max-w-2xl overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <img
          src="/images/projects/aav-hero.png"
          alt="AAV localization and environment recognition project"
          class="h-auto w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>

      <p class="mt-3 text-center text-xs text-slate-400 dark:text-slate-500">
        Autonomous aerial vehicle localization and environment recognition pipeline
      </p>
    </section>

    <!-- ================= PROJECT SNAPSHOTS ================= -->

    <section class="mb-14">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100">
          Project Snapshots
        </h2>

        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Selected visual results from the project.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">

        <!-- LiDAR -->
        <figure class="group">
          <div class="mx-auto max-w-sm overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <img
              src="/images/projects/aav-lidar.png"
              alt="LiDAR point cloud and localization"
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </div>

          <figcaption class="mx-auto mt-3 max-w-sm px-1">
            <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
              LiDAR-Based Localization
            </h3>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              LiDAR point cloud processing and motion estimation.
            </p>
          </figcaption>
        </figure>

        <!-- Trajectory -->
        <figure class="group">
          <div class="mx-auto max-w-sm overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <img
              src="/images/projects/aav-trajectory.png"
              alt="Estimated and ground truth trajectories"
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </div>

          <figcaption class="mx-auto mt-3 max-w-sm px-1">
            <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
              Trajectory Evaluation
            </h3>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Estimated vehicle trajectory and ground-truth comparison.
            </p>
          </figcaption>
        </figure>

        <!-- Visual Odometry -->
        <figure class="group">
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <img
              src="/images/projects/aav-environment2.jpg"
              alt="Visual odometry and camera-based motion estimation"
              class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </div>

          <figcaption class="mt-3 px-1">
            <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
              Visual Odometry
            </h3>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Camera-based motion estimation using visual features.
            </p>
          </figcaption>
        </figure>

        <!-- Environment Recognition -->
        <figure class="group">
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <img
              src="/images/projects/aav-environment.jpg"
              alt="Environment recognition and 3D object localization"
              class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </div>

          <figcaption class="mt-3 px-1">
            <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
              Environment Recognition
            </h3>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Object detection and 3D localization within the environment.
            </p>
          </figcaption>
        </figure>

      </div>
    </section>

    <!-- ================= PROJECT DEMO ================= -->

    <section class="mb-14">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100">
          Project Demo
        </h2>

        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          A visual demonstration of the implemented system.
        </p>
      </div>

      <div class="aspect-video w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 shadow-md dark:border-slate-700">
        <video
          controls
          preload="metadata"
          class="h-full w-full object-cover"
        >
          <source
            src="/videos/aav-demo.mp4"
            type="video/mp4"
          />
          Your browser does not support the video tag.
        </video>
      </div>
    </section>

    <!-- ================= TECHNOLOGIES & METHODS ================= -->

    <section class="mb-14">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100">
          Technologies & Methods
        </h2>

        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Sensors, algorithms, and tools used for localization, state estimation,
          and environment recognition.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">

        <!-- Sensors & Perception -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">
            Sensors & Perception
          </h3>

          <div class="flex flex-wrap gap-2">
            <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300">LiDAR</span>
            <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300">Camera</span>
            <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300">IMU</span>
            <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300">Visual Odometry</span>
            <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300">YOLO-World</span>
          </div>
        </div>

        <!-- Localization & Estimation -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">
            Localization & State Estimation
          </h3>

          <div class="flex flex-wrap gap-2">
            <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">ICP</span>
            <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Extended Kalman Filter</span>
            <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Sensor Fusion</span>
            <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">6-DoF Pose Estimation</span>
            <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Trajectory Evaluation</span>
          </div>
        </div>

        <!-- 3D Environment Understanding -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">
            3D Environment Understanding
          </h3>

          <div class="flex flex-wrap gap-2">
            <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">Point Cloud Processing</span>
            <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">Open3D</span>
            <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">3D Object Localization</span>
            <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">Object Detection</span>
          </div>
        </div>

        <!-- Software -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <h3 class="mb-3 text-sm font-semibold text-slate-800 dark:text-slate-100">
            Software & Tools
          </h3>

          <div class="flex flex-wrap gap-2">
            <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">Python</span>
            <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">Open3D</span>
            <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">NumPy</span>
            <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">Matplotlib</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ================= DOCUMENTATION ================= -->

    <section class="mb-12">
      <div class="rounded-2xl border border-indigo-100 bg-indigo-50/40 p-6 dark:border-indigo-900 dark:bg-indigo-950/30">

        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
              Documentation
            </p>

            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
              Project Report
            </h2>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Detailed methodology, implementation, experiments, and results.
            </p>
          </div>

          <a
            href="/files/reports/aav-report.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-lg border border-indigo-200 bg-white px-5 py-2.5 font-semibold text-indigo-700 shadow-sm transition-colors hover:bg-indigo-50 dark:border-indigo-800 dark:bg-slate-900 dark:text-indigo-300 dark:hover:bg-slate-800"
          >
            View Report →
          </a>
        </div>

      </div>
    </section>

    <!-- ================= FOOTER ================= -->

    <footer class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-700">
      <a
        href="/projects"
        class="flex items-center gap-2 font-medium text-indigo-600 transition-colors hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
      >
        ← Back to Projects
      </a>
    </footer>

  </article>
</BaseLayout>