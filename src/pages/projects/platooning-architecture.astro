---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectTitle = "Hybrid Data-Model-Knowledge Architecture for Platooning";
---

<BaseLayout title={projectTitle}>
  <article class="mx-auto max-w-4xl px-4 py-10">

    <!-- HEADER -->
    <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-700">
      <h1 class="mb-4 text-4xl font-extrabold text-slate-900 dark:text-slate-100">
        {projectTitle}
      </h1>

      <div class="flex flex-wrap gap-2">
        <span class="rounded-full bg-indigo-100 px-3 py-1 text-sm font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
          Research
        </span>

        <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          2026
        </span>

        <span class="rounded-full bg-amber-100 px-3 py-1 text-sm font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-300">
          Coming Soon
        </span>
      </div>
    </header>

    <!-- PROJECT OVERVIEW -->
    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
        Project Overview
      </h2>

      <p class="leading-relaxed text-slate-700 dark:text-slate-300">
        This project focuses on the development of a multi-layer supervisor
        control architecture. The goal is to bridge the gap between high-level
        Reinforcement Learning policies and low-level vehicle dynamics using
        Digital Twins.
      </p>
    </section>

    <div class="prose prose-slate max-w-none dark:prose-invert">

      <!-- SYSTEM ARCHITECTURE -->
      <section class="mb-10">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          System Architecture
        </h2>

        <figure class="my-6">
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50 p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <img
              src="/images/projects/platooning-architecture.png"
              alt="Hybrid hierarchical control architecture for vehicle platooning"
              class="h-auto w-full rounded-lg object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>

          <figcaption class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            Hybrid hierarchical control architecture: High-Level AI Decision
            Maker, Safety Supervisor, and Low-Level Model-Based Controller.
          </figcaption>
        </figure>
      </section>

      <!-- PROJECT DOCUMENTATION -->
      <section
        class="mb-10 border-t border-slate-200 pt-8 dark:border-slate-700"
      >
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Project Documentation
        </h2>

        <div class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-900 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">
              Final Report
            </h3>

            <p class="text-sm text-slate-500 dark:text-slate-400">
              Not uploaded yet.
            </p>
          </div>

          <a
            href="/files/reports/platooning-report.pdf"
            download
            class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400"
          >
            Download PDF Report
          </a>
        </div>
      </section>

    </div>

    <!-- FOOTER -->
    <footer class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-700">
      <a
        href="/projects"
        class="flex items-center gap-2 font-medium text-indigo-600 transition-colors hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
      >
        ← Back to Projects
      </a>
    </footer>

  </article>
</BaseLayout>