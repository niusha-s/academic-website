---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectTitle = "Sports Performance Analysis Device";
---

<BaseLayout title={projectTitle}>
  <article class="mx-auto max-w-4xl px-4 py-10">

    <!-- HEADER -->
    <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-700">
      <h1 class="mb-4 text-4xl font-extrabold text-slate-900 dark:text-slate-100">
        {projectTitle}
      </h1>

      <div class="flex flex-wrap gap-2">
        <span class="rounded-full bg-purple-100 px-3 py-1 text-sm font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">
          Wearable Tech
        </span>

        <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          2022
        </span>
      </div>
    </header>

    <!-- PROJECT OVERVIEW -->
    <section class="mb-12">
      <div class="border-l-4 border-gray-300 py-1 pl-6 dark:border-slate-600">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Project Overview
        </h2>

        <div class="prose prose-slate max-w-none dark:prose-invert">
          <p>
            This project focuses on the design and development of a wearable device
            for sports performance monitoring and motion analysis. The system
            analyzes limb movements during exercise to detect incorrect movement
            patterns and provide real-time feedback, helping users improve their
            technique and reduce the risk of injury.
          </p>

          <p>
            The device measures performance parameters including completed sets,
            movement speed, errors, and joint range of motion, enabling users to
            monitor their performance over time. The system also explores the use
            of range-of-motion measurements as a supplementary tool for the
            assessment of sports-related injuries.
          </p>
        </div>
      </div>
    </section>

    <!-- DOCUMENTATION SHORTCUT -->
    <div class="mb-10 flex justify-end">
      <a
        href="#documentation"
        class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
      >
        View Project Reports →
      </a>
    </div>

    <div class="prose prose-slate max-w-none dark:prose-invert">

      <!-- HARDWARE & SIGNAL DEMO -->
      <section class="mb-10">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Hardware &amp; Signal Demo
        </h2>

        <div class="flex flex-col items-center gap-8 md:flex-row md:items-start">

          <!-- HARDWARE IMAGES -->
          <div class="flex flex-col gap-4 md:w-1/3 lg:w-1/4">
            <img
              src="/images/projects/sports.jpg"
              alt="Sports performance analysis device"
              class="h-auto w-full rounded-lg border border-slate-200 shadow-md dark:border-slate-700"
              loading="lazy"
              decoding="async"
            />

            <img
              src="/images/projects/sports2.jpg"
              alt="Electronic hardware of the sports performance analysis device"
              class="h-auto w-full rounded-lg border border-slate-200 shadow-md dark:border-slate-700"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- SMARTPHONE DEMONSTRATION -->
          <div class="flex flex-1 justify-center">
            <div class="relative aspect-[10/20.5] w-48 rounded-[2.2rem] border border-slate-700 bg-slate-900 p-[5px] shadow-2xl">

              <!-- SIDE BUTTONS -->
              <div class="absolute -right-[3px] top-24 h-12 w-[3px] rounded-r-sm bg-slate-700"></div>
              <div class="absolute -left-[3px] top-20 h-7 w-[3px] rounded-l-sm bg-slate-700"></div>
              <div class="absolute -left-[3px] top-28 h-7 w-[3px] rounded-l-sm bg-slate-700"></div>

              <!-- SCREEN -->
              <div class="relative h-full w-full overflow-hidden rounded-[1.9rem] bg-black">
                <img
                  src="/gifs/sports-demo.gif"
                  alt="Sports performance analysis application demonstration"
                  class="h-full w-full object-cover"
                  loading="lazy"
                />

                <!-- CAMERA / DYNAMIC ISLAND -->
                <div class="absolute left-1/2 top-2 h-5 w-16 -translate-x-1/2 rounded-full bg-black"></div>
              </div>

            </div>
          </div>

        </div>
      </section>

      <!-- KEY CONTRIBUTIONS -->
      <section class="mb-10">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Key Contributions
        </h2>

        <ol class="list-inside list-decimal space-y-2.5 text-slate-700 dark:text-slate-300">
          <li>Wearable IMU-based motion sensing</li>
          <li>Real-time movement and error detection</li>
          <li>Range-of-motion and angular-velocity measurement</li>
          <li>Signal filtering and hysteresis-based decision logic</li>
          <li>Bluetooth communication between embedded hardware and Android</li>
          <li>Custom PCB design and hardware integration</li>
          <li>Android application for real-time performance monitoring</li>
          <li>Audible and visual feedback for movement correction</li>
        </ol>
      </section>

      <!-- TECHNOLOGIES -->
      <section class="mb-10">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Technologies
        </h2>

        <div class="grid gap-3 md:grid-cols-2">

          <!-- HARDWARE -->
          <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h3 class="mb-2 text-sm font-semibold text-slate-800 dark:text-slate-100">
              Hardware
            </h3>

            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                Arduino Nano
              </span>
              <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                MPU6050 IMU
              </span>
              <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                HC-05 Bluetooth
              </span>
              <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                Custom PCB
              </span>
              <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                Buzzer
              </span>
            </div>
          </div>

          <!-- SOFTWARE -->
          <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h3 class="mb-2 text-sm font-semibold text-slate-800 dark:text-slate-100">
              Software &amp; Tools
            </h3>

            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                C++
              </span>
              <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                Java
              </span>
              <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                Android Studio
              </span>
              <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                Arduino IDE
              </span>
              <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                Altium Designer
              </span>
            </div>
          </div>

          <!-- COMMUNICATION -->
          <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h3 class="mb-2 text-sm font-semibold text-slate-800 dark:text-slate-100">
              Communication
            </h3>

            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                I²C
              </span>
              <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                UART
              </span>
              <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                Bluetooth
              </span>
            </div>
          </div>

          <!-- METHODS -->
          <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h3 class="mb-2 text-sm font-semibold text-slate-800 dark:text-slate-100">
              Methods
            </h3>

            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-300">
                Motion Sensing
              </span>
              <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-300">
                ROM Analysis
              </span>
              <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-300">
                Moving Average Filter
              </span>
              <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-300">
                Hysteresis
              </span>
            </div>
          </div>

        </div>
      </section>

      <!-- PROJECT DOCUMENTATION -->
      <section
        id="documentation"
        class="mb-10 border-t border-slate-200 pt-8 dark:border-slate-700"
      >
        <h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">
          Project Documentation
        </h2>

        <div class="rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-900">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">

            <div class="flex-1">
              <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">
                Design Reports
              </h3>

              <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                Project documentation, including a research report on wearable
                inertial sensing for human motion analysis and sports-performance
                monitoring.
              </p>
            </div>

            <div class="flex flex-col gap-2.5 sm:w-40">

              <a
                href="/files/reports/sports-report-en.pdf"
                download
                class="inline-flex items-center justify-center rounded-lg bg-indigo-700 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-indigo-800 dark:bg-indigo-500 dark:hover:bg-indigo-400"
              >
                English Report
              </a>

              <a
                href="/files/reports/sports-report-fa.pdf"
                download
                class="inline-flex items-center justify-center rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-2.5 text-sm font-medium text-indigo-800 transition-colors hover:bg-indigo-100 dark:border-indigo-800 dark:bg-indigo-950 dark:text-indigo-200 dark:hover:bg-indigo-900"
              >
                Persian Report
              </a>

            </div>
          </div>

          <div class="mt-5 border-t border-slate-200 pt-4 dark:border-slate-700">
            <p class="text-xs leading-5 text-slate-500 dark:text-slate-400">
              <span class="font-medium text-slate-600 dark:text-slate-300">
                Note:
              </span>
              The original report was written in Persian. The English version
              was produced through AI-assisted translation and may not exactly
              preserve the wording of the original.
            </p>
          </div>
        </div>
      </section>

    </div>

    <!-- FOOTER -->
    <footer class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-700">
      <a
        href="/projects"
        class="flex items-center gap-2 font-medium text-indigo-600 transition-colors hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
      >
        ← Back to Projects
      </a>
    </footer>

  </article>
</BaseLayout>