---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectTitle = "Sports Performance Analysis Device";
const imuFormula = `$$q_{new} = q_{old} \\otimes \\Delta q$$`;
---

<BaseLayout title={projectTitle}>
  <article class="max-w-4xl mx-auto py-10 px-4">
    <header class="mb-8 border-b pb-6">
      <h1 class="text-4xl font-extrabold text-slate-900 mb-4">{projectTitle}</h1>
      <div class="flex gap-2">
        <span class="bg-purple-100 text-purple-700 px-3 py-1 rounded-full text-sm font-medium">Wearable Tech</span>
        <span class="bg-slate-100 text-slate-700 px-3 py-1 rounded-full text-sm font-medium">2022</span>
      </div>
    </header>

    <div class="prose prose-slate max-w-none">
            <!-- Hardware & Signal Demo (Multi-element Layout) -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Hardware & Signal Demo</h2>
        
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
          
          <!-- Column for the two pictures -->
          <div class="flex flex-col gap-4 md:w-1/3 lg:w-1/4">
            <img 
              src="/images/projects/sports.jpg" 
              alt="Description of picture 1" 
              class="rounded-lg shadow-md border border-slate-200 w-full h-auto"
              loading="lazy"
            />
            <img 
              src="/images/projects/sports2.jpg" 
              alt="Description of picture 2" 
              class="rounded-lg shadow-md border border-slate-200 w-full h-auto"
              loading="lazy"
            />
          </div>
          
          <!-- GIF on the right -->
          <div class="flex-1 flex justify-center">
            <div class="aspect-[9/17.25] w-56 rounded-[1.1rem] overflow-hidden border border-slate-200 shadow-md bg-slate-950">
              <img 
                src="/gifs/sports-demo.gif" 
                alt="Hardware and signal demonstration" 
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>

        </div>
      </section>




      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Motion Tracking</h2>
        <p class="text-slate-700 leading-relaxed">
          Development of a hardware prototype using IMU sensors to capture high-frequency motion data 
          for analyzing athlete biomechanics.
        </p>
      </section>

      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4">Orientation Estimation</h2>
        <div class="bg-slate-50 p-6 rounded-lg border border-slate-100 flex justify-center my-6">
          <div class="text-lg italic text-slate-800" set:html={imuFormula} />
        </div>
      </section>

      <!-- گزارش‌کار پروژه -->
      <section class="mb-10 border-t pt-8">
        <h2 class="text-2xl font-bold mb-4">Project Documentation</h2>
        <div class="p-6 bg-slate-50 border border-slate-200 rounded-xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-slate-800">Design Report</h3>
            <p class="text-sm text-slate-500">PCB layouts, sensor calibration procedures, and firmware codes.</p>
          </div>
          <a 
            href="/files/reports/sports-report.pdf" 
            download
            class="inline-flex items-center justify-center px-5 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors text-sm shadow-sm"
          >
            Download PDF Report
          </a>
        </div>
      </section>
    </div>

    <footer class="mt-12 pt-6 border-t">
      <a href="/projects" class="text-indigo-600 hover:text-indigo-800 font-medium flex items-center gap-2">
        ← Back to Projects
      </a>
    </footer>
  </article>
</BaseLayout>
