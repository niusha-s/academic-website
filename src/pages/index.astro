---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Niusha Sedgh | Electrical Engineering & Robotics"
  description="Academic portfolio of Niusha Sedgh, an electrical engineering student working on control, robotics, autonomous systems, and intelligent technologies."
>
  <div class="space-y-16">

    <!-- Hero -->
    <section class="grid gap-10 md:grid-cols-[1.5fr_0.8fr] md:items-center">

      <div class="space-y-6">

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
            Electrical Engineering · Control · Robotics
          </p>

          <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 md:text-4.5xl">
            Niusha Sedgh
          </h1>
        </div>

        <p class="max-w-2xl text-base  leading-8 text-slate-1000">
          Electrical engineering student interested in 
          control systems, robotics, and autonomous systems
          with a focus on combining classical control with
          AI-driven methods for intelligent autonomous platforms.
        </p>

        <p class="max-w-2xl text-base leading-7 text-slate-500">
          This website documents my ongoing work,
          including research projects, coursework,
          teaching, and publications in control, robotics, and related areas.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">

          <a
            href="/projects"
            class="rounded-lg bg-slate-900 px-5 py-3 text-sm font-medium text-white
                   hover:bg-slate-700 transition-colors"
          >
            View Projects
          </a>

          <a
            href="/publications"
            class="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm
                   font-medium text-slate-700 hover:border-indigo-300
                   hover:text-indigo-700 transition-colors"
          >
            Publications
          </a>

          <a
            href="/contact"
            class="rounded-lg border border-slate-200 px-5 py-3 text-sm
                   font-medium text-slate-600 hover:border-slate-300
                   hover:text-slate-900 transition-colors"
          >
            Contact
          </a>

        </div>
      </div>

      <!-- Current Status -->
      <aside class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Current Status
        </p>

        <!-- Academic Status -->
        <div class="mt-5 space-y-4">

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600">
              Bachelor Thesis
            </p>

            <p class="mt-1 text-sm leading-6 text-slate-700">
              Hybrid intelligent control architecture for vehicle platooning
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">
              Current Stage
            </p>

            <p class="mt-1 text-sm leading-6 text-slate-700">
              Literature review, system design, and research development
            </p>
          </div>

        </div>

        <!-- Divider -->
        <div class="my-5 border-t border-slate-200"></div>

        <!-- Internship -->
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">
              Internship
            </p>

            <p class="mt-1 text-sm font-medium text-slate-500">
              Embedded Systems
            </p>

            <p class="mt-2 text-sm leading-6 text-slate-700">
              AVR <span class="mx-1.5 text-slate-400">·</span>
              STM32 <span class="mx-1.5 text-slate-400">·</span>
              RTOS <span class="mx-1.5 text-slate-400">·</span>
              Embedded Linux <span class="mx-1.5 text-slate-400">·</span>
              Hardware Integration
            </p>
          </div>

      </aside>

    </section>
      
    

    <!-- Bottom CTA -->
    <section class="text-center py-4">

      <h2 class="text-2xl font-bold text-slate-900">
        Interested in research or collaboration?
      </h2>

      <p class="mt-3 text-slate-600">
        Feel free to get in touch for academic discussions and research opportunities.
      </p>

      <a
        href="/contact"
        class="inline-flex mt-5 rounded-lg bg-indigo-600 px-5 py-3 text-sm
               font-medium text-white hover:bg-indigo-700 transition-colors"
      >
        Get in Touch
      </a>

    </section>

  </div>
</BaseLayout>