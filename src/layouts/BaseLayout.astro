---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}


const { title, description = "Academic and Robotics Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- KaTeX CSS for rendering math equations -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
      integrity="sha384-GvrOXuhMATgESSwCs4UAki99FnOm8YYvp41DXf4UNhyIpG6Lia5fTqpEV5nGOrJv"
      crossorigin="anonymous"
    />
  </head>
  <script
    defer
    src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"
    integrity="sha384-z5CRfM4J2J6VJq6Yw5q5s8Ff8mFJ1V5V6q8n5x6Z6x5F7v7m5F6s5x5"
    crossorigin="anonymous"
  ></script>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll("main").forEach((main) => {
        const walker = document.createTreeWalker(
          main,
          NodeFilter.SHOW_TEXT
        );

        const nodes = [];

        while (walker.nextNode()) {
          nodes.push(walker.currentNode);
        }

        nodes.forEach((node) => {
          const text = node.textContent || "";

          if (!text.includes("$")) return;

          const parent = node.parentElement;

          if (!parent) return;

          if (
            parent.closest("code") ||
            parent.closest("pre") ||
            parent.closest(".katex")
          ) {
            return;
          }

          const html = text
            .replace(
              /\$\$([\s\S]+?)\$\$/g,
              (_, equation) =>
                `<div class="math-display">${katex.renderToString(
                  equation.trim(),
                  { displayMode: true, throwOnError: false }
                )}</div>`
            )
            .replace(
              /\$([^$]+?)\$/g,
              (_, equation) =>
                katex.renderToString(
                  equation.trim(),
                  { displayMode: false, throwOnError: false }
                )
            );

          if (html !== text) {
            const wrapper = document.createElement("span");
            wrapper.innerHTML = html;
            node.parentNode?.replaceChild(wrapper, node);
          }
        });
      });
    });
  </script>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
    
    <!-- Navigation Bar -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="font-bold text-lg text-slate-800 hover:text-blue-600 transition">
          Niusha Sedgh
        </a>
        <div class="flex gap-6 text-sm font-medium">
          <a href="/about" class="text-slate-600 hover:text-blue-600 transition">About</a>
          <a href="/projects" class="text-slate-600 hover:text-blue-600 transition">Projects</a>
          <a href="/publications" class="text-slate-600 hover:text-blue-600 transition">Publications</a>
          <a href="/beyond-engineering" class="text-slate-600 hover:text-indigo-600 transition-colors font-medium">Beyond Engineering</a>
          <a href="/contact" class="text-slate-600 hover:text-indigo-600 transition-colors font-medium">Contact</a>


        </div>
      </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 mt-12 text-center text-sm text-slate-500">
      <div class="max-w-4xl mx-auto px-4">
        © {new Date().getFullYear()} - Academic Portfolio. Built with Astro & Tailwind.
      </div>
    </footer>

  </body>
</html>
